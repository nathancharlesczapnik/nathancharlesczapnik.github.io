---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	type?: "website" | "article";
	article?: {
		headline: string;
		url: URL;
		image?: URL;
	};
}

const {
	title = "Nathan Charles Czapnik Business English Tutor",
	description = "Nathan Charles Czapnik – native speaker z Londynu. Indywidualne i grupowe lekcje angielskiego w Sandomierzu, Tarnobrzegu i online.",
	type = "website",
	article,
} = Astro.props;

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const canonicalUrl = new URL(Astro.url);
const siteIconUrl = new URL("favicon-512.png", Astro.site);
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name: "Nathan Charles Czapnik",
	alternateName: "Nathan Czapnik",
	url: new URL(base, Astro.site),
	jobTitle: "Business English Tutor",
	knowsLanguage: ["en", "pl"],
};
const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: "Nathan Charles Czapnik",
	url: new URL(base, Astro.site),
};
const articleSchema = article
	? {
			"@context": "https://schema.org",
			"@type": "Article",
			headline: article.headline,
			author: {
				"@type": "Person",
				name: "Nathan Charles Czapnik",
			},
			mainEntityOfPage: article.url,
			url: article.url,
			...(article.image ? { image: article.image } : {}),
		}
		: undefined;
---

<!doctype html>
<html lang="pl">
	<head>
  <meta name="google-site-verification" content="LVHqF2rP7hDFGqTnJ9jO7r98jCJrfyWxfGABL2MCnc8" />

		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" href="/favicon-512.png" type="image/png" sizes="512x512" />
		<link rel="apple-touch-icon" href="/favicon-512.png" />

		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Nathan Charles Czapnik" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:image" content={siteIconUrl} />
		<meta property="og:image:width" content="512" />
		<meta property="og:image:height" content="512" />
		<meta property="og:image:alt" content="Nathan Charles Czapnik — NC" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={siteIconUrl} />
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
		{articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600&family=Cormorant+Garamond:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>

	<body>
		<slot />
	</body>
</html>
